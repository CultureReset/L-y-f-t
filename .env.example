# Every value here has a working default — the platform runs with none of them
# set. Copy to .env only when you want to change something.

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# ── Persistence ───────────────────────────────────────────────────────────
# memory (default, no setup) or postgres
STORE=memory
# DATABASE_URL=postgresql://lift:lift@localhost:5432/lift

# ── Places and routing ────────────────────────────────────────────────────
# mock (default, offline, no key) · google · mapbox · osrm
GEO_PROVIDER=mock
# GEO_API_KEY=
GEO_MOCK_SPEED_KPH=32

# ── Dispatch ──────────────────────────────────────────────────────────────
# scored (default) · nearest · fastest_eta · fairness · round_robin
DISPATCH_STRATEGY=scored
DISPATCH_OFFER_TIMEOUT_MS=15000
DISPATCH_SEARCH_TIMEOUT_MS=300000
DISPATCH_OFFER_BATCH_SIZE=1

# ── Pricing ───────────────────────────────────────────────────────────────
# flat (default) · demand · scheduled · demand+scheduled
SURGE_PROVIDER=flat
SURGE_FLAT_MULTIPLIER=1
# standard (default) or free
CANCELLATION_POLICY=standard

# ── Payments ──────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=memory
# Fraction of authorizations to decline, for exercising the failure path.
PAYMENT_DECLINE_RATE=0

# ── Market ────────────────────────────────────────────────────────────────
BRAND_NAME=Lyft Clone
MARKET_NAME=San Francisco
MARKET_CENTER_LAT=37.7749
MARKET_CENTER_LNG=-122.4194
CURRENCY=USD

# ── Development conveniences (refused in production) ───────────────────────
# A fixed sign-in code, so no SMS provider is needed.
DEV_AUTH_CODE=000000
# Approve drivers as soon as their documents are submitted.
AUTO_APPROVE_DRIVERS=true
SEED_ON_BOOT=true
