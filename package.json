{
  "name": "lift-platform",
  "private": true,
  "version": "1.0.0",
  "description": "L-Y-F-T \u2014 a modular, end-to-end ridehail platform: rider app, driver app, dispatch backend, ops console, and fleet simulator.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && npm run test",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "api": "npm run dev -w @lift/api",
    "sim": "npm run dev -w @lift/simulator",
    "rider": "npm run start -w @lift/rider",
    "driver": "npm run start -w @lift/driver",
    "admin": "npm run dev -w @lift/admin",
    "platform": "concurrently -n api,sim -c cyan,magenta \"npm run api:clean\" \"sleep 4 && npm run sim\"",
    "seed": "npm run seed -w @lift/api",
    "db:generate": "npm run db:generate -w @lift/api",
    "db:migrate": "npm run db:migrate -w @lift/api",
    "api:clean": "SEED_ON_BOOT=false npm run api",
    "brand": "python3 tools/brand/src/generate.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "vite": "^6.0.7"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0"
  }
}
