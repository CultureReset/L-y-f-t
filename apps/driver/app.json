{
  "expo": {
    "name": "Lyft Clone Driver",
    "slug": "lift-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "liftdriver",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0C0C0F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.lift.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0C0F"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK"
      ],
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.lift.driver",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is shared with riders while you are online so they can see you on the way.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your location keeps updating while you are on a trip, even with the app in the background.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "buildNumber": "1"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is shared with riders while you are online.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "primaryColor": "#0C0C0F"
  }
}
